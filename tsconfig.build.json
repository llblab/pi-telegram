{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "newLine": "lf",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "."
  },
  "include": [
    "index.ts",
    "api/**/*.ts",
    "lib/**/*.ts"
  ]
}
